<%= form_with model: [:admin, material_category], local: true, class: "space-y-4 max-w-xl" do |f| %>
  <% if material_category.errors.any? %>
    <div class="bg-red-50 text-red-800 text-sm rounded-md p-4">
      <ul class="list-disc list-inside">
        <% material_category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :code, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :code, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :name, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :position, class: "block text-sm font-medium text-slate-700" %>
    <%= f.number_field :position, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_area :description, rows: 3, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <%= f.submit class: "bg-orange-500 hover:bg-orange-600 text-white px-6 py-2.5 rounded-md font-semibold cursor-pointer" %>
<% end %>
