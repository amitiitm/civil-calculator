<% content_for :title, "Edit User Role" %>

<h1 class="text-2xl font-bold text-slate-900 mb-6">Edit Role - <%= @user.email %></h1>

<%= form_with model: [:admin, @user], local: true, class: "space-y-4 max-w-sm" do |f| %>
  <div>
    <%= f.label :role, class: "block text-sm font-medium text-slate-700" %>
    <%= f.select :role, User.roles.keys.map { |k| [k.humanize, k] }, {}, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <%= f.submit "Update Role", class: "bg-orange-500 hover:bg-orange-600 text-white px-6 py-2.5 rounded-md font-semibold cursor-pointer" %>
<% end %>
