<%= form_with model: [:admin, construction_setting], local: true, class: "space-y-4 max-w-xl" do |f| %>
  <% if construction_setting.errors.any? %>
    <div class="bg-red-50 text-red-800 text-sm rounded-md p-4">
      <ul class="list-disc list-inside">
        <% construction_setting.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :key, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :key, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm font-mono text-sm" %>
  </div>
  <div>
    <%= f.label :value, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :value, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :data_type, class: "block text-sm font-medium text-slate-700" %>
    <%= f.select :data_type, %w[string integer decimal boolean], {}, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :group, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :group, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_area :description, rows: 2, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <%= f.submit class: "bg-orange-500 hover:bg-orange-600 text-white px-6 py-2.5 rounded-md font-semibold cursor-pointer" %>
<% end %>
