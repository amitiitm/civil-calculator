<% content_for :title, "Construction Settings" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-slate-900">Construction Settings</h1>
  <%= link_to "+ New Setting", new_admin_construction_setting_path, class: "bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-md font-semibold text-sm" %>
</div>

<div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50">
      <tr class="text-left text-gray-500">
        <th class="py-2 px-4">Group</th>
        <th class="py-2 px-4">Key</th>
        <th class="py-2 px-4">Value</th>
        <th class="py-2 px-4">Description</th>
        <th class="py-2 px-4"></th>
      </tr>
    </thead>
    <tbody>
      <% @construction_settings.each do |setting| %>
        <tr class="border-t border-gray-100">
          <td class="py-2 px-4"><%= setting.group %></td>
          <td class="py-2 px-4 font-mono text-xs"><%= setting.key %></td>
          <td class="py-2 px-4"><%= setting.value %></td>
          <td class="py-2 px-4 text-gray-500"><%= setting.description %></td>
          <td class="py-2 px-4 text-right">
            <%= link_to "Edit", edit_admin_construction_setting_path(setting), class: "text-slate-500 mr-3" %>
            <%= button_to "Delete", admin_construction_setting_path(setting), method: :delete, class: "text-red-500 inline", data: { turbo_confirm: "Delete this setting?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
