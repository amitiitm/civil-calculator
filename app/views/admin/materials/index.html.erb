<% content_for :title, "Materials" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-slate-900">Materials</h1>
  <%= link_to "+ New Material", new_admin_material_path, class: "bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-md font-semibold text-sm" %>
</div>

<div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50">
      <tr class="text-left text-gray-500">
        <th class="py-2 px-4">Code</th>
        <th class="py-2 px-4">Name</th>
        <th class="py-2 px-4">Category</th>
        <th class="py-2 px-4">Unit</th>
        <th class="py-2 px-4">Rate</th>
        <th class="py-2 px-4">Wastage %</th>
        <th class="py-2 px-4">Active</th>
        <th class="py-2 px-4"></th>
      </tr>
    </thead>
    <tbody>
      <% @materials.each do |material| %>
        <tr class="border-t border-gray-100">
          <td class="py-2 px-4"><%= material.code %></td>
          <td class="py-2 px-4"><%= material.name %></td>
          <td class="py-2 px-4"><%= material.material_category.name %></td>
          <td class="py-2 px-4"><%= material.unit %></td>
          <td class="py-2 px-4">&#8377;<%= material.default_rate %></td>
          <td class="py-2 px-4"><%= material.wastage_percentage %>%</td>
          <td class="py-2 px-4"><%= material.active? ? "Yes" : "No" %></td>
          <td class="py-2 px-4 text-right">
            <%= link_to "Edit", edit_admin_material_path(material), class: "text-slate-500 mr-3" %>
            <%= button_to "Delete", admin_material_path(material), method: :delete, class: "text-red-500 inline", data: { turbo_confirm: "Delete this material?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
