<% content_for :title, "Calculation Formulas" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-slate-900">Calculation Formulas</h1>
  <%= link_to "+ New Formula", new_admin_calculation_formula_path, class: "bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-md font-semibold text-sm" %>
</div>

<div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50">
      <tr class="text-left text-gray-500">
        <th class="py-2 px-4">Category</th>
        <th class="py-2 px-4">Name</th>
        <th class="py-2 px-4">Version</th>
        <th class="py-2 px-4">Active</th>
        <th class="py-2 px-4"></th>
      </tr>
    </thead>
    <tbody>
      <% @calculation_formulas.each do |formula| %>
        <tr class="border-t border-gray-100">
          <td class="py-2 px-4 font-mono text-xs"><%= formula.category_code %></td>
          <td class="py-2 px-4"><%= formula.name %></td>
          <td class="py-2 px-4">v<%= formula.version %></td>
          <td class="py-2 px-4"><%= formula.active? ? "Yes" : "No" %></td>
          <td class="py-2 px-4 text-right">
            <%= link_to "View", admin_calculation_formula_path(formula), class: "text-slate-500 mr-3" %>
            <%= link_to "Edit", edit_admin_calculation_formula_path(formula), class: "text-slate-500 mr-3" %>
            <%= button_to "Delete", admin_calculation_formula_path(formula), method: :delete, class: "text-red-500 inline", data: { turbo_confirm: "Delete this formula?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
