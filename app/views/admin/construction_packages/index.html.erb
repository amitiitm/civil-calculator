<% content_for :title, "Construction Packages" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-slate-900">Construction Packages</h1>
  <%= link_to "+ New Package", new_admin_construction_package_path, class: "bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-md font-semibold text-sm" %>
</div>

<div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50">
      <tr class="text-left text-gray-500">
        <th class="py-2 px-4">Name</th>
        <th class="py-2 px-4">Slug</th>
        <th class="py-2 px-4">Rate/sqft</th>
        <th class="py-2 px-4">Active</th>
        <th class="py-2 px-4"></th>
      </tr>
    </thead>
    <tbody>
      <% @construction_packages.each do |package| %>
        <tr class="border-t border-gray-100">
          <td class="py-2 px-4"><%= package.name %></td>
          <td class="py-2 px-4"><%= package.slug %></td>
          <td class="py-2 px-4">&#8377;<%= package.rate_per_sqft %></td>
          <td class="py-2 px-4"><%= package.active? ? "Yes" : "No" %></td>
          <td class="py-2 px-4 text-right">
            <%= link_to "Edit", edit_admin_construction_package_path(package), class: "text-slate-500 mr-3" %>
            <%= button_to "Delete", admin_construction_package_path(package), method: :delete, class: "text-red-500 inline", data: { turbo_confirm: "Delete this package?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
