<%= form_with model: [:admin, construction_package], local: true, class: "space-y-4 max-w-xl" do |f| %>
  <% if construction_package.errors.any? %>
    <div class="bg-red-50 text-red-800 text-sm rounded-md p-4">
      <ul class="list-disc list-inside">
        <% construction_package.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :name, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :slug, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :slug, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :rate_per_sqft, "Rate per sqft (INR)", class: "block text-sm font-medium text-slate-700" %>
    <%= f.number_field :rate_per_sqft, step: 0.01, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :position, class: "block text-sm font-medium text-slate-700" %>
    <%= f.number_field :position, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_area :description, rows: 3, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div class="flex items-center gap-2">
    <%= f.check_box :active %>
    <%= f.label :active, class: "text-sm font-medium text-slate-700" %>
  </div>

  <%= f.submit class: "bg-orange-500 hover:bg-orange-600 text-white px-6 py-2.5 rounded-md font-semibold cursor-pointer" %>
<% end %>
