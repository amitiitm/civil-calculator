<% content_for :title, "My Projects - BuildEstimate" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-slate-900">My Projects</h1>
  <%= link_to "New Project", new_project_path, class: "bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-md font-semibold" %>
</div>

<% if @projects.empty? %>
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-10 text-center text-gray-600">
    No projects yet. <%= link_to "Create your first project", new_project_path, class: "text-orange-600 font-semibold" %>.
  </div>
<% else %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <% @projects.each do |project| %>
      <%= link_to project_path(project), class: "block bg-white rounded-xl border border-gray-100 shadow-sm p-6 hover:border-orange-300" do %>
        <div class="flex items-center justify-between">
          <h3 class="font-semibold text-slate-900"><%= project.name %></h3>
          <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-600"><%= project.status.humanize %></span>
        </div>
        <p class="text-sm text-gray-600 mt-1"><%= project.client_name %></p>
        <p class="text-sm text-gray-500 mt-2"><%= project.city %>, <%= project.state %></p>
        <p class="text-xs text-gray-400 mt-3">Updated <%= time_ago_in_words(project.updated_at) %> ago</p>
      <% end %>
    <% end %>
  </div>
<% end %>
