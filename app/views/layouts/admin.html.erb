<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin - BuildEstimate" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-slate-900 min-h-screen flex">
    <aside class="w-64 bg-slate-900 text-white shrink-0">
      <div class="px-5 py-4 text-lg font-bold border-b border-slate-700">
        Build<span class="text-orange-500">Estimate</span> Admin
      </div>
      <nav class="px-3 py-4 flex flex-col gap-1 text-sm">
        <%= link_to "Dashboard", admin_root_path, class: "px-3 py-2 rounded hover:bg-slate-800" %>
        <%= link_to "Material Categories", admin_material_categories_path, class: "px-3 py-2 rounded hover:bg-slate-800" %>
        <%= link_to "Materials", admin_materials_path, class: "px-3 py-2 rounded hover:bg-slate-800" %>
        <%= link_to "Construction Settings", admin_construction_settings_path, class: "px-3 py-2 rounded hover:bg-slate-800" %>
        <%= link_to "Construction Packages", admin_construction_packages_path, class: "px-3 py-2 rounded hover:bg-slate-800" %>
        <%= link_to "Calculation Formulas", admin_calculation_formulas_path, class: "px-3 py-2 rounded hover:bg-slate-800" %>
        <%= link_to "Labour Rates", admin_labour_rates_path, class: "px-3 py-2 rounded hover:bg-slate-800" %>
        <%= link_to "Users", admin_users_path, class: "px-3 py-2 rounded hover:bg-slate-800" %>
        <div class="border-t border-slate-700 my-2"></div>
        <%= link_to "Back to site", root_path, class: "px-3 py-2 rounded hover:bg-slate-800" %>
      </nav>
    </aside>

    <div class="flex-1">
      <div class="px-8 py-4">
        <% if notice %>
          <div class="bg-green-50 text-green-800 text-sm px-4 py-3 rounded mb-4"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="bg-red-50 text-red-800 text-sm px-4 py-3 rounded mb-4"><%= alert %></div>
        <% end %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
