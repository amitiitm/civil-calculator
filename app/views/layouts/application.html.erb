<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "BuildEstimate - Smart Home Construction Calculator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-slate-900 min-h-screen flex flex-col">
    <header class="bg-slate-900 text-white">
      <nav class="container mx-auto px-5 py-4 flex items-center justify-between">
        <%= link_to root_path, class: "text-xl font-bold tracking-tight" do %>
          Build<span class="text-orange-500">Estimate</span>
        <% end %>
        <div class="flex items-center gap-6 text-sm font-medium">
          <%= link_to "Home", root_path, class: "hover:text-orange-400" %>
          <% if user_signed_in? %>
            <%= link_to "My Projects", projects_path, class: "hover:text-orange-400" %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_root_path, class: "hover:text-orange-400" %>
            <% end %>
            <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "hover:text-orange-400" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "hover:text-orange-400" %>
            <%= link_to "Register", new_user_registration_path, class: "bg-orange-500 text-white px-4 py-2 rounded-md hover:bg-orange-600" %>
          <% end %>
        </div>
      </nav>
    </header>

    <% if notice %>
      <div class="bg-green-50 text-green-800 text-sm px-5 py-3 border-b border-green-200"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="bg-red-50 text-red-800 text-sm px-5 py-3 border-b border-red-200"><%= alert %></div>
    <% end %>

    <main class="container mx-auto px-5 py-8 flex-1">
      <%= yield %>
    </main>

    <footer class="bg-slate-900 text-gray-400 text-sm mt-auto">
      <div class="container mx-auto px-5 py-6 flex flex-col sm:flex-row justify-between gap-2">
        <p>&copy; <%= Date.current.year %> BuildEstimate. Preliminary estimates only - not a substitute for a qualified structural engineer.</p>
        <p>Currency: INR (&#8377;)</p>
      </div>
    </footer>
  </body>
</html>

