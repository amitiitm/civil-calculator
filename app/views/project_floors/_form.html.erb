<%= form_with model: project_floor, url: (project_floor.persisted? ? project_floor_path(project_floor) : project_project_floors_path(@project)), local: true, class: "space-y-4" do |f| %>
  <% if project_floor.errors.any? %>
    <div class="bg-red-50 text-red-800 text-sm rounded-md p-4">
      <ul class="list-disc list-inside">
        <% project_floor.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :floor_number, class: "block text-sm font-medium text-slate-700" %>
    <%= f.number_field :floor_number, min: 1, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :name, placeholder: "Ground Floor", class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :floor_height_ft, "Floor height (ft)", class: "block text-sm font-medium text-slate-700" %>
    <%= f.number_field :floor_height_ft, step: 0.1, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>
  <div>
    <%= f.label :footprint_percentage, "Footprint coverage (%)", class: "block text-sm font-medium text-slate-700" %>
    <%= f.number_field :footprint_percentage, min: 1, max: 100, step: 1, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
    <p class="text-xs text-gray-500 mt-1">Use less than 100% for a partial top floor (e.g. 50% for the ".5" in a 2.5-floor project).</p>
  </div>
  <div>
    <%= f.label :bhk_type, "BHK configuration (for average doors/windows)", class: "block text-sm font-medium text-slate-700" %>
    <%= f.select :bhk_type, ProjectFloor.bhk_types.keys.map { |k| [k.humanize, k] }, { include_blank: "No automatic doors/windows" }, class: "mt-1 w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <%= f.submit class: "bg-orange-500 hover:bg-orange-600 text-white px-6 py-2.5 rounded-md font-semibold cursor-pointer" %>
<% end %>
